NODE_ENV=development
PORT=4000
# Number of reverse proxies in front of the API (e.g. 1), or their addresses.
# Leave empty when clients connect to the API directly.
TRUST_PROXY=

DATABASE_URL=postgresql://postgres:password@localhost:5432/3i_platform

JWT_ACCESS_SECRET=your-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

REDIS_URL=redis://localhost:6379

STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# Email (Resend). MAIL_FROM must be on a domain verified in Resend.
# Leave RESEND_API_KEY empty in development to log emails instead of sending.
# EMAIL_ENABLED=false turns email off entirely.
RESEND_API_KEY=
MAIL_FROM=noreply@3iinstitute.edu
MAIL_FROM_NAME=3i Institute
MAIL_REPLY_TO=
EMAIL_ENABLED=true

SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

FRONTEND_URL=http://localhost:3000
PWNED_API_URL=https://api.pwnedpasswords.com/range
# Firebase Admin (push notifications). Use ONE of these. Keep the key file
# outside the repo, or in backend/secrets/ (git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Social login. GOOGLE_CLIENT_ID is the WEB OAuth client ID (also used by the
# Android app as its server client ID). GOOGLE_MOBILE_CLIENT_IDS lists extra
# accepted client IDs, comma-separated — set the iOS OAuth client ID here.
GOOGLE_CLIENT_ID=
GOOGLE_MOBILE_CLIENT_IDS=
APPLE_CLIENT_ID=
